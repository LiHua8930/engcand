<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AssemblyName>EngCandCoreTests</AssemblyName>
    <RootNamespace>EngCandCoreTests</RootNamespace>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <InvariantGlobalization>true</InvariantGlobalization>
    <EnableDefaultApplicationDefinition>false</EnableDefaultApplicationDefinition>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\..\src\EngCand\Contracts.cs" Link="src\Contracts.cs" />
    <Compile Include="..\..\src\EngCand\Core\WordBuffer.cs" Link="src\Core\WordBuffer.cs" />
    <Compile Include="..\..\src\EngCand\Core\KeyboardHook.cs" Link="src\Core\KeyboardHook.cs" />
    <Compile Include="..\..\src\EngCand\Core\SogouStateObserver.cs" Link="src\Core\SogouStateObserver.cs" />
    <Compile Include="..\..\src\EngCand\Core\TextInjector.cs" Link="src\Core\TextInjector.cs" />
  </ItemGroup>

</Project>
